<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebExamenFinalDG.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> · Examen Final</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" runat="server" />
    <link href="~/Content/SiteDG.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form id="frmPrincipalDG" runat="server">
        <header class="encabezado-dg">
            <nav class="navbar navbar-expand-md navbar-dark">
                <div class="container">
                    <a class="navbar-brand marca-dg" runat="server" href="~/">
                        <span class="marca-icono-dg">DG</span> Examen Final
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenuDG" aria-controls="navMenuDG" aria-expanded="false" aria-label="Abrir menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse justify-content-end" id="navMenuDG">
                        <ul class="navbar-nav menu-dg">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Default.aspx">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/About.aspx">Acerca de</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact.aspx">Contacto</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <main class="container py-4 contenido-dg">
            <asp:ContentPlaceHolder ID="cphContenidoDG" runat="server" />
        </main>
        <footer class="pie-dg">
            <div class="container d-flex flex-column flex-md-row justify-content-between gap-1">
                <span>&copy; <%: DateTime.Now.Year %> · Examen Final de Programación II</span>
                <span>Daniela Paola Grajeda Sandoval · Universidad Mariano Gálvez de Guatemala</span>
            </div>
        </footer>
    </form>
    <script src="<%: ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
</body>
</html>
