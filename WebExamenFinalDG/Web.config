<?xml version="1.0" encoding="utf-8"?>
<!-- Configuracion del sitio Examen Final - Daniela Paola Grajeda Sandoval -->
<configuration>
  <appSettings>
    <!-- Validadores de Web Forms sin dependencia de jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Datos del alumno mostrados en Contacto (cambiar aqui si es necesario) -->
    <add key="AlumnoNombreDG" value="Daniela Paola Grajeda Sandoval" />
    <add key="AlumnoCarneDG" value="0900-25-15929" />
    <add key="AlumnoSeccionDG" value="A" />
    <add key="AlumnoCursoDG" value="Programacion II" />
    <!-- Correo de soporte opcional: dejar vacio para no mostrarlo -->
    <add key="AlumnoCorreoDG" value="" />
  </appSettings>
  <connectionStrings>
    <!-- Cambie Data Source por el nombre de su servidor SQL si es distinto -->
    <add name="cnnExamenDG"
         connectionString="Data Source=ML-RefVm-941826\SQLEXPRESS;Initial Catalog=ExamenFinalProductosDG;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="en-US" uiCulture="es-GT" requestEncoding="utf-8" responseEncoding="utf-8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" validateRequest="true" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Default.aspx" />
  </system.web>
</configuration>
